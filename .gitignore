# Design sources (canvas boards, the scripts that generate them, the canvas images) are tracked;
# local previews (*.html made by dc2html.py) and screenshots are generated, so they stay out.
.aidesigner/*
!.aidesigner/.gitkeep
!.aidesigner/*.py
!.aidesigner/canvas/
!.aidesigner/_blob/
!.aidesigner/stampila.html
.aidesigner/__pycache__/

# Next.js / Node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.env*
!.env.example
# generated by scripts/images.mjs
public/_img/
src/generated/
# Playwright / Wrangler
playwright-report/
test-results/
blob-report/
.wrangler/
.dev.vars*
.lighthouseci/
