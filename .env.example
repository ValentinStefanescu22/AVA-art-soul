# Copy to .env.local for local overrides. Nothing here is secret: these values end up in the public HTML.
# The Cloudflare API token is NOT set here; it lives only in GitHub Secrets (see docs/deploy.md).

# Origin the site is served from (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" only on the real domain at launch. Anything else: robots.txt blocks everything and pages say noindex.
SITE_INDEXABLE=false

# Cloudflare Web Analytics site token (cookie-free). Leave empty to disable analytics.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
